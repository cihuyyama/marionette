# Rust
/target/
**/*.rs.bk
**/__pycache__/
**/*.pyc
Cargo.lock.bak

# Secrets & data
.env
.env.*
!.env.example
# Everything under data/ is local (token dumps, proxy lists, QA logs, DBs) — never commit.
data/
**/*token*
**/*secret*
**/accounts*.json
# Qoder farm credentials (scripts/automation/qoder_farm)
scripts/automation/**/accounts.txt
scripts/automation/**/accounts*.txt
!scripts/automation/**/accounts.txt.example
# Blackbox farm secrets/outputs (scripts/automation/blackbox_farm)
scripts/automation/blackbox_farm/.env
scripts/automation/blackbox_farm/screenshots/*
!scripts/automation/blackbox_farm/screenshots/.gitkeep
scripts/automation/blackbox_farm/data/
scripts/automation/blackbox_farm/results/*
!scripts/automation/blackbox_farm/results/.gitkeep
# Proxy pool lists (host:port:user:pass) — credentials, never commit.
**/proxies.txt
**/*proxy*.txt
**/*proxies*.txt
!docs/**
# HANDOFF / DEPLOYMENT hold VPS host/user/key path + infra layout — local only.
# MUST stay below `!docs/**`: last matching rule wins.
docs/HANDOFF.md
docs/DEPLOYMENT.md
docs/QODER_ENDPOINTS.md
docs/*

# Agent scratch / continuation state
.omo/
.omc/
/refs/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
.playwright-mcp/

# Dashboard
web/node_modules/
web/dist/
web/.vite/


# Added by cargo

/target
