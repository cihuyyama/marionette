# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Secrets & data
.env
.env.*
!.env.example
# Everything under data/ is local (token dumps, proxy lists, QA logs, DBs) — never commit.
data/
**/*token*
**/*secret*
**/accounts*.json
# Qoder farm credentials (scripts/automation/qoder_farm)
scripts/automation/**/accounts.txt
scripts/automation/**/accounts*.txt
!scripts/automation/**/accounts.txt.example
# Proxy pool lists (host:port:user:pass) — credentials, never commit.
**/proxies.txt
**/*proxy*.txt
**/*proxies*.txt
!docs/**
# HANDOFF / DEPLOYMENT hold VPS host/user/key path + infra layout — local only.
# MUST stay below `!docs/**`: last matching rule wins.
docs/HANDOFF.md
docs/DEPLOYMENT.md
docs/QODER_ENDPOINTS.md
docs/*

# Agent scratch / continuation state
.omo/
.omc/
/refs/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log

# Dashboard
web/node_modules/
web/dist/
web/.vite/


# Added by cargo

/target
