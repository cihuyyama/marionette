MARIONETTE_HOST=0.0.0.0
MARIONETTE_PORT=1940
MARIONETTE_DB=./data/marionette.sqlite
MARIONETTE_API_KEY=change-me-to-a-long-random-string
MARIONETTE_ADMIN_KEY=change-me-admin-separate-from-pool
MARIONETTE_CORS_ORIGIN=http://localhost:1941
# Production: info. For local debugging use info,marionette=debug
RUST_LOG=info

# Optional
# MARIONETTE_COOLDOWN_HOURS=25
# MARIONETTE_AUTH_COOLDOWN_HOURS=5
# Store chat request/response JSON on request_logs (Activity detail drawer)
# MARIONETTE_LOG_BODY_ENABLED=true
# MARIONETTE_LOG_BODY_MAX_BYTES=262144
# Encrypt provider credentials (`accounts.data`) at rest with AES-256-CBC.
# Leave unset to keep storing as-is (opt-in, so nobody gets locked out of an
# existing pool). BACK THIS UP: losing the key makes every stored credential
# unreadable, and there is no recovery path.
# MARIONETTE_DATA_KEY=

# Request-log retention. Captured bodies are ~99% of DB volume, so they expire
# on a much shorter window than the metadata row that owns them (tokens,
# credits, status, timing stay queryable). Sweep runs every
# MARIONETTE_RETENTION_INTERVAL_SECS; set it to 0 to disable.
# MARIONETTE_LOG_BODY_RETENTION_DAYS=7
# MARIONETTE_LOG_RETENTION_DAYS=30
# MARIONETTE_RETENTION_INTERVAL_SECS=3600
# MARIONETTE_GROK_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828
# MARIONETTE_REFRESH_LEAD_SECS=10800
# MARIONETTE_REFRESH_INTERVAL_SECS=1800
# MARIONETTE_REFRESH_WORKERS=8
# How often to re-resolve provider client versions from their public release
# endpoints (grok-cli, kiro). These are gated upstream: a stale version makes
# every dispatch fail with 426 Upgrade Required, so they are resolved at
# runtime rather than pinned in the binary. 0 disables the worker.
# MARIONETTE_VERSION_REFRESH_INTERVAL_SECS=21600
# MARIONETTE_STATIC_DIR=./web/dist
# Route grok-cli upstream (chat/imagine/refresh) via HTTP/SOCKS5 proxy.
# Use residential egress on datacenter hosts: xAI suppresses reasoning
# summary streams for datacenter IPs. Example: socks5://127.0.0.1:40000
# MARIONETTE_GROK_PROXY=
#
# Antigravity (Google Cloud Code Assist) OAuth client identity.
# The upstream client is a public installed-app client, but a literal in source
# is a secret in git history forever and hosting providers block the push on
# sight, so these are supplied here instead.
# MARIONETTE_ANTIGRAVITY_CLIENT_ID=
# MARIONETTE_ANTIGRAVITY_CLIENT_SECRET=

# Farm (dashboard Automation) — Python packages under scripts/automation/
# Paths are resolved absolute at startup (job cwd is data/farm/jobs/<id>).
# Prefer absolute package dirs if you start the server outside the repo root.
# MARIONETTE_FARM_PYTHON=C:\laragon\bin\python\python-3.10\python.exe
# MARIONETTE_FARM_DIR=./scripts/automation/qoder_farm
# MARIONETTE_GROK_FARM_DIR=./scripts/automation/grok_farm
# MARIONETTE_FARM_DATA=./data/farm
# Max parallel account workers per job (UI default is still 1)
# MARIONETTE_FARM_MAX_CONCURRENCY=8
