MARIONETTE_HOST=0.0.0.0
MARIONETTE_PORT=1940
MARIONETTE_DB=./data/marionette.sqlite
MARIONETTE_API_KEY=change-me-to-a-long-random-string
MARIONETTE_ADMIN_KEY=change-me-admin-separate-from-pool
MARIONETTE_CORS_ORIGIN=http://localhost:1941
RUST_LOG=info,marionette=debug

# Optional
# MARIONETTE_COOLDOWN_HOURS=25
# MARIONETTE_AUTH_COOLDOWN_HOURS=5
# Store chat request/response JSON on request_logs (Activity detail drawer)
# MARIONETTE_LOG_BODY_ENABLED=true
# MARIONETTE_LOG_BODY_MAX_BYTES=262144
# MARIONETTE_GROK_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828
# MARIONETTE_REFRESH_LEAD_SECS=10800
# MARIONETTE_REFRESH_INTERVAL_SECS=1800
# MARIONETTE_REFRESH_WORKERS=8
# MARIONETTE_STATIC_DIR=./web/dist
#
# Farm (dashboard Automation) — Python packages under scripts/automation/
# Paths are resolved absolute at startup (job cwd is data/farm/jobs/<id>).
# Prefer absolute package dirs if you start the server outside the repo root.
# MARIONETTE_FARM_PYTHON=C:\laragon\bin\python\python-3.10\python.exe
# MARIONETTE_FARM_DIR=./scripts/automation/qoder_farm
# MARIONETTE_GROK_FARM_DIR=./scripts/automation/grok_farm
# MARIONETTE_FARM_DATA=./data/farm
# Max parallel account workers per job (UI default is still 1)
# MARIONETTE_FARM_MAX_CONCURRENCY=8
# Dudul inject access key (qoder only) — real value only in local .env, never commit
# QODER_DUDUL_ACCESS_KEY=
# MARIONETTE_DUDUL_ACCESS_KEY=
