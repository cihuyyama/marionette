# Copy to .env (never commit .env)

# Browser (plain Playwright Chromium — no anti-detect)
BLACKBOX_HEADLESS=true
BLACKBOX_TIMEOUT=30
BLACKBOX_OTP_TIMEOUT=120

# Self-hosted dreamhunter2333/cloudflare_temp_email worker (register mode).
# The Marionette runner also injects these from DB mail settings per run.
BLACKBOX_CF_MAIL_BASE_URL=
BLACKBOX_CF_MAIL_ADMIN_PASSWORD=
BLACKBOX_CF_MAIL_DOMAIN=
# Only if the worker runs in site-wide private mode (env PASSWORDS):
BLACKBOX_CF_MAIL_SITE_PASSWORD=
