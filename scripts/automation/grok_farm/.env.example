# Copy to .env (never commit .env)

# Browser
GROK_HEADLESS=false
GROK_BROWSER_OS=windows
GROK_LOGIN_TIMEOUT=120
GROK_OAUTH_TIMEOUT=120

# Humanize (Camoufox): ON by default — scale 0.5 headed / 0.8 headless
GROK_HUMANIZE=true
GROK_HUMANIZE_HEADED=0.5
GROK_HUMANIZE_HEADLESS=0.8

# Optional proxy: http://user:pass@host:port
GROK_PROXY_URL=
# Or a file of proxies (one per line); rotates per browser launch
GROK_PROXY_FILE=
GROK_PROXY_SHUFFLE=true
# Hard override: 1/true forces direct even if the above are set.
# The dashboard "Automation proxy = off" toggle sets this per run via --no-proxy.
GROK_NO_PROXY=false

# OAuth (defaults match Grok CLI / Marionette)
# GROK_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828
# GROK_REDIRECT_URI=http://127.0.0.1:56121/callback

# Output
GROK_OUTPUT=./results/grok-accounts.json
GROK_SCREENSHOT_DIR=./screenshots

# UI: log | hud
GROK_UI=log
GROK_DEBUG=false
# GROK_JSON_PROGRESS=false
# GROK_SKIP_VERIFY=false

# IMAP only if xAI shows OTP during login/OAuth (optional)
# GROK_IMAP_HOST=imap.gmail.com
# GROK_IMAP_PORT=993
# GROK_IMAP_USER=
# GROK_IMAP_PASS=
