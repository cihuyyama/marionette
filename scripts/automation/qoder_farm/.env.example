# Copy to .env (never commit .env)

# Browser
QODER_HEADLESS=false
QODER_BROWSER_OS=windows
QODER_LOGIN_TIMEOUT=120

# Optional proxy: http://user:pass@host:port
QODER_PROXY_URL=
# Or a file of proxies (one per line); rotates per browser launch
QODER_PROXY_FILE=
QODER_PROXY_SHUFFLE=true
# Hard override: 1/true forces direct even if the above are set.
# The dashboard "Automation proxy = off" toggle sets this per run via --no-proxy.
QODER_NO_PROXY=false
QODER_HUMANIZE=true

# After PAT: settle before dudul inject (seconds)
QODER_INJECT_SETTLE_SECS=5

# dudul.dev inject (trial / credits helper)
# Form: #key + #pat  payload { "pat", "key" }. Turnstile only if page still shows widget.
QODER_DUDUL_INJECT=true
QODER_DUDUL_URL=https://dudul.dev/inject
# Required for inject. Put real value only in local .env (gitignored).
QODER_DUDUL_ACCESS_KEY=
QODER_INJECT_MAX_ATTEMPTS=8
QODER_INJECT_BACKOFF=2,2,2,2,2,2,2
QODER_INJECT_TOTAL_BUDGET_S=300

# Output
QODER_OUTPUT=./results/qoder-accounts.json
QODER_SCREENSHOT_DIR=./screenshots

# UI: log | hud
QODER_UI=log
QODER_DEBUG=false

# IMAP reserved for CF Email Routing domain mailboxes only (NOT GSuite OTP).
# GSuite path never needs these.
# --- register mode (email signup + IMAP OTP) ---
# QODER_IMAP_HOST=imap.gmail.com
# QODER_IMAP_PORT=993
# QODER_IMAP_USER=you@gmail.com
# QODER_IMAP_PASS=app-password-no-spaces
# Password used for every created account:
# QODER_REGISTER_PASSWORD=
# Email source: catch-all "yourdomain.com" (random local) or "you@gmail.com" (plus-tags):
# QODER_EMAIL_SOURCE=
# Captcha: auto (solver) | manual (human solves in window) | auto-then-manual (fallback)
# QODER_CAPTCHA_MODE=auto
# QODER_CAPTCHA_MANUAL_TIMEOUT=180
# Max auto slide attempts per signup (F015-flagged IPs never pass — keep low):
# QODER_CAPTCHA_MAX_ATTEMPTS=4
# Wall-clock budget per account attempt in seconds (abort + rotate proxy; 0=off):
# QODER_REGISTER_ACCOUNT_BUDGET_S=240
